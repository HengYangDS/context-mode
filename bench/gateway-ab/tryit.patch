+  assert.throws(() => sessionTenant({ stamp: "", w: "x", role: "measured", cycle: 1, attempt: 1 }), FailClosed);
+});
+
+const tr = (content) => ({ type: "user", message: { content: [{ type: "tool_result", tool_use_id: "u", content }] } });
+const said = (text) => ({ type: "assistant", message: { content: [{ type: "text", text }] } });
+
+test("amendment 1: JSON objects in tool_result text are found by brace matching, strings with braces included", () => {
+  assert.deepEqual(jsonObjectsIn('count: 2\n{"id": 1, "s": "a } b"} tail {bad} {"x": {"y": 2}}'), [{ id: 1, s: "a } b" }, { x: { y: 2 } }]);
+  assert.deepEqual(toolResultTexts([tr("plain"), tr([{ type: "text", text: "t1" }, { type: "image" }]), said("no")]), ["plain", "t1"]);
+});
+
+test("amendment 1: large-json reference is the index-13000 record from the tool_result; pass needs every leaf", () => {
+  const rec = { id: 13000, name: "user_13000", secret: true, message: "The eagle lands at midnight", tags: ["a", "b"] };
+  const ev = [tr("payload: 7.5 MB\n" + JSON.stringify({ status: 200, record: rec }, null, 2))];
+  assert.equal(largeJsonTranscriptWhy(ev, "id 13000 user_13000 secret true: The eagle lands at midnight, tags a b"), "ok");
+  assert.equal(largeJsonTranscriptWhy(ev, "id 13000 user_13000 true The eagle lands"), "answer-missing-2-of-6-values");
+  // string index, nested array, last tool_result wins
+  const ev2 = [tr(JSON.stringify([{ index: "13000", v: "old" }])), tr(JSON.stringify({ records: [{ index: 13000, v: "new" }] }))];
+  assert.deepEqual(recordFromToolResults(toolResultTexts(ev2), 13000), { index: 13000, v: "new" });
+  // record only in model prose or nowhere: fail closed
+  assert.equal(largeJsonTranscriptWhy([said(JSON.stringify(rec))], JSON.stringify(rec)), "no-record-in-tool-result");
+  assert.equal(largeJsonTranscriptWhy([tr("index 13000 looked fine")], "x"), "no-record-in-tool-result");
+});
+
+test("amendment 1: the gateway's edge calls count for the completion check; none still fails", () => {
+  const p = { result: { subtype: "success", stop_reason: "end_turn" }, tools: {} };
+  assert.equal(completionWhy("", {}, "answer", p), "no-tool-call");
+  assert.equal(completionWhy("", {}, "answer", { ...p, edge_calls: 1 }), "ok");
+});
