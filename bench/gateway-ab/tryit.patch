index ecbd3532..1c2deaa2 100644
--- a/scripts/e2e/oss-arms-lib.mjs
+++ b/scripts/e2e/oss-arms-lib.mjs
@@ -290,3 +290,85 @@ export function buildEvidence({ runs, workloads, arms, labels, meta }) {
     workloads: out,
   };
 }
+
+// ── prereg amendment 1 (docs/benchmarks/try-it/prereg-amendment-1.md on OSS v2-design) ──────────────────────────
+/** One NEW disposable tenant per gateway SESSION (not per prompt): the cycle's role, number and attempt are in the id,
+ *  so no session can read memory, skills or archive written by an earlier session. Owner tenants throw. */
+export function sessionTenant({ stamp, w, role, cycle, attempt }, isOwner = () => false) {
+  if (!stamp || !w || !role || !(cycle >= 0) || !(attempt >= 1)) throw new FailClosed("session-tenant", "stamp, w, role, cycle, attempt are required");
+  const t = "t_ossab_" + stamp + "_" + w + "_" + role.charAt(0) + cycle + "a" + attempt;
+  if (isOwner(t)) throw new FailClosed("owner-tenant", "refused");
+  return t;
+}
+
+/** The text of every tool_result block the client saw, in transcript order (string content or its text blocks). */
+export function toolResultTexts(events) {
+  const out = [];
+  for (const e of events || []) {
+    if (!e || e.type !== "user" || !e.message || !Array.isArray(e.message.content)) continue;
+    for (const b of e.message.content) {
+      if (!b || b.type !== "tool_result") continue;
+      if (typeof b.content === "string") out.push(b.content);
+      else if (Array.isArray(b.content)) out.push(b.content.filter((c) => c && c.type === "text").map((c) => String(c.text || "")).join("\n"));
+    }
+  }
+  return out;
+}
+
+/** Every top-level JSON object embedded in a text, found by brace matching (JSON string state aware) and JSON.parse.
+ *  No regex. Text that does not parse is skipped. */
+export function jsonObjectsIn(text) {
+  const s = String(text || ""), out = [];
+  let i = 0;
+  while (i < s.length) {
+    if (s.charAt(i) !== "{") { i++; continue; }
+    let depth = 0, inStr = false, esc = false, end = -1;
+    for (let k = i; k < s.length; k++) {
+      const ch = s.charAt(k);
+      if (inStr) { if (esc) esc = false; else if (ch === "\\") esc = true; else if (ch === "\"") inStr = false; continue; }
+      if (ch === "\"") inStr = true;
+      else if (ch === "{") depth++;
+      else if (ch === "}") { depth--; if (depth === 0) { end = k; break; } }
+    }
+    if (end < 0) { i++; continue; }
+    let j = null; try { j = JSON.parse(s.slice(i, end + 1)); } catch { j = null; }
+    if (j && typeof j === "object") { out.push(j); i = end + 1; } else i++;
+  }
+  return out;
+}
+
+/** The record a tool_result served or generated at `index`: an object (at any depth of a JSON object parsed from a
+ *  tool_result) whose own `id` or `index` key equals the index (number, or the same digits as a string). The LAST such
+ *  object in transcript order wins (the final fetch). null when no tool_result holds one (fail closed). */
+export function recordFromToolResults(texts, index) {
+  let found = null;
+  const want = String(index);
+  const hit = (o) => ["id", "index"].some((k) => Object.prototype.hasOwnProperty.call(o, k) && (o[k] === index || o[k] === want));
+  const walk = (v) => {
+    if (!v || typeof v !== "object") return;
+    if (!Array.isArray(v) && hit(v)) found = v;
+    for (const x of Object.values(v)) walk(x);
+  };
+  for (const t of texts || []) for (const o of jsonObjectsIn(t)) walk(o);
+  return found;
+}
+
+/** Scalar leaves of a record, as the strings that must appear whole in the answer. */
+export function recordLeaves(v, out = []) {
+  if (v === null || v === undefined) return out;
+  if (typeof v === "object") { for (const x of Object.values(v)) recordLeaves(x, out); return out; }
+  out.push(String(v));
+  return out;
+}
+
+/** large-json oracle (amendment 1): the reference is the record the session's own tool_result showed at index 13000;
+ *  pass when every leaf value appears whole in the final answer. No such tool_result: "no-record-in-tool-result". */
+export function largeJsonTranscriptWhy(events, answer, index = 13000) {
+  const rec = recordFromToolResults(toolResultTexts(events), index);
+  if (rec === null) return "no-record-in-tool-result";
+  const need = recordLeaves(rec);
+  if (need.length === 0) return "empty-reference-record";
+  const s = String(answer || "");
+  const miss = need.filter((x) => s.indexOf(x) < 0);
+  return miss.length === 0 ? "ok" : "answer-missing-" + miss.length + "-of-" + need.length + "-values";
+}
